# Docker Compose / Postgres init
POSTGRES_USER=chouchou
POSTGRES_PASSWORD=chouchou
POSTGRES_DB=chouchou

# libpq/libpqxx connection settings used by the app and tests
PGHOST=localhost
PGPORT=5432
PGUSER=chouchou
PGPASSWORD=chouchou
PGDATABASE=chouchou

# HTTP server listen address
HOST=0.0.0.0
PORT=3000

# Logging (trace|debug|info|warning|error|fatal) and log file directory
LOG_LEVEL=info
LOG_DIR=logs
